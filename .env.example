DJANGO_SETTINGS_MODULE=campus_maintainance_request_system.settings.dev
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_HSTS_SECONDS=0
DB_ENGINE=postgresql

POSTGRES_DB=campus-maintainance-request-system
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-local-database-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

MAX_PHOTO_SIZE=5242880
MAX_PHOTO_WIDTH=4096
MAX_PHOTO_HEIGHT=4096
MAX_PHOTO_PIXELS=16777216

DEMO_USER_PASSWORD=
